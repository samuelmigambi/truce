{
  "name": "truce",
  "version": "0.1.0",
  "private": true,
  "description": "Truce handles PayPal disputes for small online sellers: it prevents the avoidable ones and fights the winnable ones.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:live": "node scripts/dev-live.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@paypal/react-paypal-js": "^10.6.1",
    "clsx": "^2.1.1",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.62.0",
    "motion": "^14.7.1",
    "next": "16.4.3",
    "openai": "^7.45.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "swr": "^2.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
