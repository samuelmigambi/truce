# Truce reads these on the server only. Copy this file to .env.local and fill in what you have.
# `npm run dev:live` fills most of them from Google Secret Manager and Firebase for you.

# ---- Accounts: Firebase Authentication (Identity Platform) ----
# The web app's config is public (browsers need it to sign in); the server serves it at runtime
# from /api/auth/config, so nothing is baked in at build time.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=truce-disputes.firebaseapp.com
FIREBASE_APP_ID=
# Shows "Continue with Google" once the Google provider is on in the Firebase console.
TRUCE_GOOGLE_SIGN_IN=0
# Local test accounts: point sign-in at the Firebase Auth emulator (npm run dev:live -- --emulator).
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- Secrets at rest ----
# 32 random bytes, base64 (Secret Manager: truce-encryption-key). Seals each shop's PayPal secret
# with AES-256-GCM. Without it, shops can't connect PayPal. To rotate, move the old key to
# TRUCE_ENCRYPTION_KEY_PREVIOUS and reconnect or re-save.
TRUCE_ENCRYPTION_KEY=
# TRUCE_ENCRYPTION_KEY_PREVIOUS=

# ---- NVIDIA Nemotron on Nebius Token Factory (https://tokenfactory.nebius.com) ----
NEBIUS_API_KEY=
# The model for each job. These are the defaults; change one without touching the code.
TRUCE_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
TRUCE_MODEL_DRAFT=nvidia/Nemotron-3.5-Super-VL
TRUCE_MODEL_DECIDE=nvidia/Nemotron-3-Ultra-550b-a55b
TRUCE_MODEL_EMBED=Qwen/Qwen3-Embedding-8B
# Daily cap on model spend across every shop, in dollars
TRUCE_DAILY_SPEND_CAP=5

# ---- The demo storefront's own PayPal app (/shop) ----
# Shops connect their own PayPal apps in the app; these are only for the Wick & Ember storefront.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The webhook registered on that app before shops had their own (not a secret).
PAYPAL_WEBHOOK_ID=

# Tavily, for reading a shop's listing and policy pages as the buyer saw them
TAVILY_API_KEY=

# The public address of the app. PayPal webhooks and Tavily need it to be public; a local
# address makes Truce skip the webhook (and check PayPal on its own) and say so.
SITE_URL=http://localhost:3100

# ---- Where data lives ----
# memory, or firestore (the default when Google credentials are found)
TRUCE_STORE=memory
TRUCE_GCP_PROJECT=truce-disputes
# GOOGLE_APPLICATION_CREDENTIALS=
# FIRESTORE_EMULATOR_HOST=
# Local credentials are a person's: Firebase Auth's admin calls need a project to bill.
# GOOGLE_CLOUD_QUOTA_PROJECT=truce-disputes

# Lets a scheduler call POST /api/jobs/overnight (sent as the x-truce-job-key header)
TRUCE_JOB_KEY=
