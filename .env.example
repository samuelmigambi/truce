# Truce reads these on the server only. Copy this file to .env.local and fill in what you have.
# Every service is optional: without a key, that part of the app says it isn't connected.

# NVIDIA Nemotron on Nebius Token Factory (https://tokenfactory.nebius.com)
NEBIUS_API_KEY=

# The model for each job. These are the defaults; change one without touching the code.
TRUCE_MODEL_FAST=nvidia/Nemotron-3_5-Lightning
TRUCE_MODEL_DRAFT=nvidia/Nemotron-3.5-Super-VL
TRUCE_MODEL_DECIDE=nvidia/Nemotron-3-Ultra-550b-a55b
TRUCE_MODEL_EMBED=Qwen/Qwen3-Embedding-8B

# A PayPal REST app with Customer Disputes turned on. Sandbox unless PAYPAL_ENV=live.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# The webhook registered for the app (not a secret); needed only to receive dispute webhooks.
PAYPAL_WEBHOOK_ID=

# Tavily, for reading the listing and policies as the buyer saw them
TAVILY_API_KEY=

# The public address of the app. Tavily reads the shop's pages from here; a local address
# makes Truce use the catalog's copy instead, and say so.
SITE_URL=http://localhost:3000

# Where data lives: memory, or firestore (the default when Google credentials are found)
TRUCE_STORE=memory
TRUCE_GCP_PROJECT=truce-disputes
# GOOGLE_APPLICATION_CREDENTIALS=
# FIRESTORE_EMULATOR_HOST=

# Signs the owner in to the live sandbox workspace at /owner
TRUCE_OWNER_KEY=
# Lets a scheduler call POST /api/jobs/overnight (sent as the x-truce-job-key header)
TRUCE_JOB_KEY=

# Daily cap on model spend across every visitor, in dollars
TRUCE_DAILY_SPEND_CAP=5
